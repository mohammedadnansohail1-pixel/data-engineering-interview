{
  "info": {
    "name": "Data Engineering Interview Prep API",
    "description": "Complete API collection for the interview preparation platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "questionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\",\n  \"full_name\": \"Demo User\",\n  \"experience_level\": \"mid\",\n  \"target_role\": \"Senior Data Engineer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login (JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login/json",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login", "json"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Questions",
      "item": [
        {
          "name": "List All Questions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.length > 0) {",
                  "        pm.collectionVariables.set('questionId', jsonData[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/questions/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "questions", ""]
            }
          }
        },
        {
          "name": "Filter Questions - SQL",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/questions/?category=sql",
              "host": ["{{baseUrl}}"],
              "path": ["api", "questions", ""],
              "query": [
                {
                  "key": "category",
                  "value": "sql"
                }
              ]
            }
          }
        },
        {
          "name": "Filter Questions - Easy",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/questions/?difficulty=easy",
              "host": ["{{baseUrl}}"],
              "path": ["api", "questions", ""],
              "query": [
                {
                  "key": "difficulty",
                  "value": "easy"
                }
              ]
            }
          }
        },
        {
          "name": "Search Questions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/questions/?search=pandas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "questions", ""],
              "query": [
                {
                  "key": "search",
                  "value": "pandas"
                }
              ]
            }
          }
        },
        {
          "name": "Get Question by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/questions/{{questionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "questions", "{{questionId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Practice",
      "item": [
        {
          "name": "Start Question Attempt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question_id\": \"{{questionId}}\",\n  \"status\": \"in_progress\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/practice/start",
              "host": ["{{baseUrl}}"],
              "path": ["api", "practice", "start"]
            }
          }
        },
        {
          "name": "Submit Python Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question_id\": \"{{questionId}}\",\n  \"code\": \"def solution():\\n    return 'Hello World'\",\n  \"language\": \"python\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/practice/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "practice", "submit"]
            }
          }
        },
        {
          "name": "Submit SQL Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question_id\": \"{{questionId}}\",\n  \"code\": \"SELECT date, amount, SUM(amount) OVER (ORDER BY date) as running_total FROM sales ORDER BY date;\",\n  \"language\": \"sql\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/practice/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "practice", "submit"]
            }
          }
        },
        {
          "name": "Get Hint (Level 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question_id\": \"{{questionId}}\",\n  \"current_code\": \"SELECT * FROM sales\",\n  \"hint_number\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/practice/hint",
              "host": ["{{baseUrl}}"],
              "path": ["api", "practice", "hint"]
            }
          }
        }
      ]
    },
    {
      "name": "Progress",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/progress/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["api", "progress", "dashboard"]
            }
          }
        },
        {
          "name": "Get Skills Progress",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/progress/skills",
              "host": ["{{baseUrl}}"],
              "path": ["api", "progress", "skills"]
            }
          }
        }
      ]
    },
    {
      "name": "Health & Status",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Root Endpoint",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            }
          }
        }
      ]
    }
  ]
}
